<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">x86</Platform>
    <OutputName>PasswordManagerAppInstaller</OutputName>
    <WixTargetsPath Condition="'$(WixTargetsPath)' == ''">$(ProgramFiles)\WiX Toolset v3.11\bin\Wix.targets</WixTargetsPath>
    <WixTargetsPath Condition="!Exists('$(WixTargetsPath)')">$(ProgramFiles(x86))\WiX Toolset v3.11\bin\Wix.targets</WixTargetsPath>
    <WixToolPath Condition="'$(WixToolPath)' == ''">$(ProgramFiles)\WiX Toolset v3.11\bin</WixToolPath>
    <WixToolPath Condition="!Exists('$(WixToolPath)')">$(ProgramFiles(x86))\WiX Toolset v3.11\bin</WixToolPath>
  </PropertyGroup>

  <ItemGroup>
    <WixSourceFile Include="Product.wxs" />
    <WixSourceFile Include="AppFiles.wxs" />
  </ItemGroup>

  <Target Name="PublishApp" BeforeTargets="BeforeBuild">
    <Message Text="Publishing PasswordManagerApp to installer publish folder..." Importance="high" />
    <Exec Command="dotnet publish ..\\PasswordManagerApp.csproj -c $(Configuration) -o &quot;$(MSBuildThisFileDirectory)publish&quot;" />
  </Target>

  <Target Name="HarvestAppFiles" BeforeTargets="BeforeBuild" DependsOnTargets="PublishApp">
    <Message Text="Harvesting published files for WiX installer..." Importance="high" />
    <Exec Command="&quot;$(WixToolPath)\heat.exe&quot; dir &quot;$(MSBuildThisFileDirectory)publish&quot; -ag -srd -cg AppFiles -dr INSTALLFOLDER -out &quot;$(MSBuildThisFileDirectory)AppFiles.wxs&quot;" />
  </Target>

  <Import Project="$(WixTargetsPath)" Condition="Exists('$(WixTargetsPath)')" />
</Project>
